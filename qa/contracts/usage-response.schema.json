{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://seoradar.example/schemas/usage-response.schema.json",
  "title": "SeoRadar — Kullanım Yanıtı (UsageResponse)",
  "description": "GET /api/usage uç noktasının döndürdüğü gövde. Bu şema SeoRadar'a aittir.",
  "type": "object",
  "required": ["ok", "usage", "plan"],
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "İstek başarılı ise true"
    },
    "plan": {
      "type": "string",
      "enum": ["free", "pro"],
      "description": "x-seoradar-plan başlığı 'pro' ise pro, aksi halde free"
    },
    "usage": {
      "type": "object",
      "required": ["used", "limit"],
      "additionalProperties": false,
      "properties": {
        "used": {
          "type": "integer",
          "minimum": 0,
          "description": "Bugün tüketilen analiz hakkı"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Günlük üst sınır (free planda 3)"
        }
      }
    }
  }
}