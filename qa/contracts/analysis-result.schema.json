{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://seoradar.example/schemas/analysis-result.schema.json",
  "title": "SeoRadar — Analiz Sonucu (AnalysisResult)",
  "description": "POST /api/analyze uç noktasının döndürdüğü gövde. Bu şema, SeoRadar'ın kendi sözleşmesidir ve diğer projelerle paylaşılmaz.",
  "type": "object",
  "required": ["url", "score", "grade", "checks", "metrics", "summary", "plan", "dailyUsage"],
  "additionalProperties": false,
  "x-invariants": [
    {
      "sum": ["summary.passed", "summary.warnings", "summary.errors"],
      "equals": "summary.total",
      "message": "summary.toplam: passed + warnings + errors toplamı total değerine eşit olmalı"
    }
  ],
  "properties": {
    "url": {
      "type": "string",
      "description": "Normalize edilmiş istek URL'si",
      "pattern": "^https?://"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Ağırlıklı genel SEO skoru"
    },
    "grade": {
      "type": "string",
      "enum": ["A+", "A", "B", "C", "D", "F"]
    },
    "plan": {
      "type": "string",
      "enum": ["free", "pro"]
    },
    "dailyUsage": {
      "type": "object",
      "required": ["used", "limit"],
      "additionalProperties": false,
      "properties": {
        "used": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1 }
      }
    },
    "summary": {
      "type": "object",
      "required": ["passed", "warnings", "errors", "total"],
      "additionalProperties": false,
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "description": "passed + warnings + errors === total olmalıdır"
    },
    "checks": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/definitions/CheckItem" }
    },
    "metrics": { "$ref": "#/definitions/PageMetrics" }
  },
  "definitions": {
    "Severity": {
      "type": "string",
      "enum": ["success", "warning", "error", "info"]
    },
    "CheckCategory": {
      "type": "string",
      "enum": ["onpage", "technical", "content", "links"]
    },
    "CheckItem": {
      "type": "object",
      "required": ["id", "title", "category", "severity", "summary", "howToFix", "weight", "score"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "description": "Stabil anahtar; en az şunları içermeli: title, meta-description, h1, heading-hierarchy, images-alt, images-dimensions, links-structure, links-broken, https, robots-txt, sitemap, open-graph, twitter-card, structured-data, viewport, html-lang, canonical, content-length, hreflang, html-weight"
        },
        "title": { "type": "string", "minLength": 2 },
        "category": { "$ref": "#/definitions/CheckCategory" },
        "severity": { "$ref": "#/definitions/Severity" },
        "summary": { "type": "string", "minLength": 2 },
        "value": { "type": "string" },
        "howToFix": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 },
          "description": "Türkçe, uygulanabilir öneriler"
        },
        "proDetail": {
          "type": "string",
          "description": "Ücretsiz planda arayüzde bulanıklaştırılır"
        },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "PageMetrics": {
      "type": "object",
      "required": [
        "url", "finalUrl", "fetchedAt", "loadTimeMs", "htmlSizeBytes",
        "titleLength", "metaDescriptionLength", "headings", "images", "links",
        "technical", "wordCount", "textToHtmlRatio", "contentLength"
      ],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "finalUrl": { "type": "string", "description": "Yönlendirmelerden sonraki URL" },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "loadTimeMs": { "type": "integer", "minimum": 0 },
        "htmlSizeBytes": { "type": "integer", "minimum": 0 },
        "title": { "type": ["string", "null"] },
        "titleLength": { "type": "integer", "minimum": 0 },
        "metaDescription": { "type": ["string", "null"] },
        "metaDescriptionLength": { "type": "integer", "minimum": 0 },
        "canonical": { "type": ["string", "null"] },
        "lang": { "type": ["string", "null"] },
        "viewport": { "type": ["string", "null"] },
        "charset": { "type": ["string", "null"] },
        "headings": {
          "type": "object",
          "required": ["h1", "h2", "h3", "h4", "h5", "h6"],
          "additionalProperties": false,
          "properties": {
            "h1": { "type": "array", "items": { "type": "string" } },
            "h2": { "type": "array", "items": { "type": "string" } },
            "h3": { "type": "array", "items": { "type": "string" } },
            "h4": { "type": "array", "items": { "type": "string" } },
            "h5": { "type": "array", "items": { "type": "string" } },
            "h6": { "type": "array", "items": { "type": "string" } }
          }
        },
        "images": {
          "type": "object",
          "required": ["total", "missingAlt", "missingAltSrcs", "emptyAlt", "missingDimensions", "lazyLoaded"],
          "additionalProperties": false,
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "missingAlt": { "type": "integer", "minimum": 0 },
            "missingAltSrcs": { "type": "array", "items": { "type": "string" } },
            "emptyAlt": { "type": "integer", "minimum": 0 },
            "missingDimensions": { "type": "integer", "minimum": 0 },
            "lazyLoaded": { "type": "integer", "minimum": 0 }
          }
        },
        "links": {
          "type": "object",
          "required": ["total", "internal", "external", "noFollow", "empty", "checked", "broken"],
          "additionalProperties": false,
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "internal": { "type": "integer", "minimum": 0 },
            "external": { "type": "integer", "minimum": 0 },
            "noFollow": { "type": "integer", "minimum": 0 },
            "empty": { "type": "integer", "minimum": 0 },
            "checked": { "type": "integer", "minimum": 0 },
            "broken": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["href"],
                "additionalProperties": false,
                "properties": {
                  "href": { "type": "string" },
                  "status": { "type": ["integer", "null"] },
                  "error": { "type": "string" }
                }
              }
            }
          }
        },
        "technical": {
          "type": "object",
          "required": [
            "isHttps", "hasRobotsTxt", "hasSitemapXml", "hasFavicon",
            "hasOpenGraph", "openGraphKeys", "hasTwitterCard",
            "hasStructuredData", "structuredDataTypes", "hasHreflang",
            "inlineStyles", "scriptCount", "stylesheetCount"
          ],
          "additionalProperties": false,
          "properties": {
            "isHttps": { "type": "boolean" },
            "hasRobotsTxt": { "type": "boolean" },
            "robotsTxtContent": { "type": ["string", "null"] },
            "hasSitemapXml": { "type": "boolean" },
            "hasFavicon": { "type": "boolean" },
            "hasOpenGraph": { "type": "boolean" },
            "openGraphKeys": { "type": "array", "items": { "type": "string" } },
            "hasTwitterCard": { "type": "boolean" },
            "hasStructuredData": { "type": "boolean" },
            "structuredDataTypes": { "type": "array", "items": { "type": "string" } },
            "hasHreflang": { "type": "boolean" },
            "inlineStyles": { "type": "integer", "minimum": 0 },
            "scriptCount": { "type": "integer", "minimum": 0 },
            "stylesheetCount": { "type": "integer", "minimum": 0 }
          }
        },
        "wordCount": { "type": "integer", "minimum": 0 },
        "textToHtmlRatio": { "type": "number", "minimum": 0 },
        "contentLength": { "type": "integer", "minimum": 0 }
      }
    }
  }
}